# Copy to .env (gitignored). Without ANTHROPIC_API_KEY the app runs in offline mode and replays the examples.
ANTHROPIC_API_KEY=
HALDEN_MODEL=claude-sonnet-4-5
HALDEN_DAILY_CAP=40
HALDEN_IP_HOURLY_CAP=5
# Set to 1 to force offline mode even with a key (useful for screenshots and tests).
HALDEN_OFFLINE=
